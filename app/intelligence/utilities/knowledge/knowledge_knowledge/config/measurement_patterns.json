  "confidence_rules": {

    "contains_number": 0.20,

    "contains_unit": 0.20,

    "contains_metric": 0.25,

    "contains_modifier": 0.15,

    "contains_trend": 0.20
  },

  "normalization": {

    "remove_commas": true,

    "trim_spaces": true,

    "convert_percent_to_decimal": false,

    "standardize_currency": true,

    "normalize_case": true
  },
  
  "regex_patterns": {
    "integer": "\\b\\d+\\b",

    "decimal": "\\b\\d+\\.\\d+\\b",

    "percentage": "\\b\\d+(\\.\\d+)?\\s?%\\b",

    "currency": "(\\$|USD|CAD|EUR|GBP|PKR|AED|SAR|INR)\\s?\\d+[\\d,]*(\\.\\d+)?",

    "range": "\\b\\d+(\\.\\d+)?\\s?(to|-|–)\\s?\\d+(\\.\\d+)?\\b",

    "fraction": "\\b\\d+\\/\\d+\\b",

    "multiplier": "\\b\\d+(\\.\\d+)?\\s?(k|m|b|t)\\b",

    "year": "\\b(19|20)\\d{2}\\b",

    "month_year": "(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\s+\\d{4}",

    "duration": "\\b\\d+\\s?(days?|weeks?|months?|years?|hrs?|hours?|minutes?)\\b"
  },

